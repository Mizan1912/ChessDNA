# Copy this file to .env and fill in real values. Never commit .env itself.
# Read by both /frontend (Vite, only VITE_-prefixed names) and /api once Phase 3
# adds functions there. Variables are added here only when the code that reads
# them exists, so this file never lists something before it's actually used.

# Chess.com public API base URL. Not a secret — this is only here so the
# endpoint can be overridden (e.g. for local testing) without touching code.
# Optional: the app falls back to the real endpoint if this is unset.
VITE_CHESSCOM_API_BASE_URL=https://api.chess.com/pub

# MongoDB Atlas connection string. Required, secret. Read only by /api
# functions, never by browser-side code.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# Google Identity Services Client ID. Not a secret, but not hardcoded either.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:3001

# /server (Express) only, below this line — never VITE_-prefixed, never sent
# to the browser.
GOOGLE_CLIENT_ID=<same-client-id-as-above>.apps.googleusercontent.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-32-byte-hex-string>

CORS_ORIGIN=http://localhost:5173
SERVER_PORT=3001
