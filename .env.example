# Copy this file to .env and fill in real values. Never commit .env itself.
# One file for the whole project: /frontend (Vite, which only exposes
# VITE_-prefixed names to the browser) and /server (Express) both read it.
# Variables are added here only when the code that reads them exists.
#
# In PRODUCTION there is no .env file. The same names are typed into each
# host's dashboard instead — the frontend ones into Vercel, the server ones
# into Render. Each value below notes what it becomes in production. See
# decision.md D-045.

# ─── Frontend (Vercel) ─── baked into the JS at BUILD time: changing one
# means redeploying, not just restarting.

# Chess.com public API base URL. Not a secret — only here so the endpoint can
# be overridden without touching code. Optional: falls back to the real one.
# Production: same value.
VITE_CHESSCOM_API_BASE_URL=https://api.chess.com/pub

# Google Identity Services Client ID. Not a secret, but not hardcoded either.
# Production: same value.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Where the browser sends /api requests.
# Local dev: the Express server directly.
# Production: "/" — meaning "this same site". Vercel then forwards /api/* to
# the backend (frontend/vercel.json), which keeps the login cookie same-site.
VITE_API_BASE_URL=http://localhost:3001

# ─── Server (Render) ─── never VITE_-prefixed, never sent to the browser.

# MongoDB Atlas connection string. Required, SECRET.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# Same Client ID as above, read server-side to verify Google's tokens.
GOOGLE_CLIENT_ID=<same-client-id-as-above>.apps.googleusercontent.com

# Signs our own session cookie. SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: generate a FRESH one rather than reusing your local one.
JWT_SECRET=<generate-a-random-32-byte-hex-string>

# The only site allowed to call the API with cookies.
# Production: your Vercel URL, e.g. https://chess-dna.vercel.app (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# Local dev only. In production the host picks the port and passes it in as
# PORT, which the server reads first — do not set this on Render.
SERVER_PORT=3001

# Production only — do not set locally. Turns on the `Secure` flag on the
# session cookie, which browsers require over HTTPS. Without it, sign-in
# appears to work and then silently doesn't stick.
# NODE_ENV=production
