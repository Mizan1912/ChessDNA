# Copy this file to .env and fill in real values. Never commit .env itself.
# Read by both /frontend (Vite, only VITE_-prefixed names) and /api once Phase 3
# adds functions there. Variables are added here only when the code that reads
# them exists, so this file never lists something before it's actually used.

# Chess.com public API base URL. Not a secret — this is only here so the
# endpoint can be overridden (e.g. for local testing) without touching code.
# Optional: the app falls back to the real endpoint if this is unset.
VITE_CHESSCOM_API_BASE_URL=https://api.chess.com/pub
